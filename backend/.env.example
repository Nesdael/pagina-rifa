# Conexión a PostgreSQL (en Railway se copia la variable DATABASE_URL del servicio de Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rifa
PORT=3000

# Clave para entrar al panel /admin (cámbiala por una difícil)
ADMIN_KEY=cambia-esta-clave

# Datos de la rifa
PRECIO=5000
PREMIO=150000
LOTERIA=Sinuano Noche
FECHA_SORTEO=2026-10-30
# WhatsApp del dueño, con indicativo y sin "+" ni espacios
WHATSAPP=573001234567
# Minutos que dura un número apartado sin pagar antes de liberarse solo
MINUTOS_APARTADO=120
# Déjalo vacío hasta que juegue la lotería; luego pon las dos cifras, ej: 07
GANADOR=
